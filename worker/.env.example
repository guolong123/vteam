# worker 环境配置示例：复制为 .env 并填写必填项。
# 注意：.env 已被 .gitignore 忽略，勿提交真实 token。

# 必填：注册鉴权 token（对齐协议 X-Worker-Token header，需与 server 侧约定一致）
X_WORKER_TOKEN=change-me-worker-token

# server 基址（nest 默认 3000）
SERVER_URL=http://localhost:3000

# worker 唯一 id；缺省为 w_<hostname>
# WORKER_ID=w_my-worker-1

# worker 可读名称（注册时可选展示）；缺省为 hostname
# WORKER_NAME=my-worker-1

# opencode serve 端口；0 = OS 随机空闲端口（D2 随机端口 + 冲突重试策略起点，T3）
# OPENCODE_SERVE_PORT=0

# opencode serve 认证密码（D2 Basic Auth username=opencode）；空 = serve 不设鉴权
# OPENCODE_SERVER_PASSWORD=change-me-serve-password

# 心跳间隔 ms；缺省 10000（server 30s=3 周期未收心跳判 offline）
# HEARTBEAT_INTERVAL_MS=10000

# 日志级别：debug | info | warn | error
# LOG_LEVEL=info

# opencode serve 工作目录（T5：.opencode/tools/ 注入落点）
# WORK_DIR=/tmp/keta-worker

# SSH 私钥路径（T5 git 凭证注入：GIT_SSH_KEY_PATH）；空 = 不注入 GIT_SSH_COMMAND
# GIT_SSH_KEY_PATH=/home/keta/.ssh/id_ed25519
