# worker 环境配置示例：复制为 .env 并填写必填项。
# 注意：.env 已被 .gitignore 忽略，勿提交真实 token。

# 必填：注册鉴权 token（对齐协议 X-Worker-Token header，需与 server 侧约定一致）
X_WORKER_TOKEN=change-me-worker-token

# server 基址（nest 默认 3000）
SERVER_URL=http://localhost:3000

# 内置 vteam MCP 地址覆盖（集群外 worker 用；覆盖 server 下发的内置地址）。
# server 下发的默认内置 MCP 地址（seed PLATFORM_MCP_URL）为集群内服务名
# （http://server:3000/... 或 http://vteam-server:3000/...），集群外 worker 无法解析，
# 必须设置为外部可达的控制面地址（如 http://<控制面外部地址>/api/v1/platform-mcp）。
# 未设置 = 用 server 下发的全局地址（集群内 worker 默认，无需配置）。
# WORKER_MCP_URL=http://<控制面外部地址>/api/v1/platform-mcp

# worker 唯一 id；缺省为 w_<hostname>
# WORKER_ID=w_my-worker-1

# worker 可读名称（注册时可选展示）；缺省为 hostname
# WORKER_NAME=my-worker-1

# opencode serve 端口；0 = OS 随机空闲端口（D2 随机端口 + 冲突重试策略起点，T3）
# 安装后 worker 启动探测实际端口 → 持久化回 OPENCODE_SERVE_PORT=（重启不变沿）。显式设值（如 45087）保留。
# OPENCODE_SERVE_PORT=0

# opencode serve 认证密码（D2 Basic Auth username=opencode）；空 = serve 不设鉴权
# OPENCODE_SERVER_PASSWORD=change-me-serve-password

# 心跳间隔 ms；缺省 10000（server 30s=3 周期未收心跳判 offline）
# HEARTBEAT_INTERVAL_MS=10000

# 日志级别：debug | info | warn | error
# LOG_LEVEL=info

# opencode serve 工作目录（T5：.opencode/tools/ 注入落点）
# WORK_DIR=/tmp/vteam-worker

# opencode serve 绑定地址（D2：默认 127.0.0.1 本地铁律；容器内设 0.0.0.0 供 server 容器访问）。
# 集群外/跨机 worker 必须设 0.0.0.0（serve 监听非回环，server 才能连上）
# OPENCODE_SERVE_HOSTNAME=127.0.0.1

# opencode --pure 开关（D2 铁律：去插件/MEMORY 注入/默认 agent，缺失将 input tokens 高达 7601）。
# 默认 true（vteam 通过 MCP 管控 worker），设 false 允许 opencode 加载插件——注意会跳脱 vteam 管控
# + 与平台记忆冲突 + token 增升，外部用请自担。
# WORKER_OPENCODE_PURE=true

# worker 对 server 公布的 serve 基址主机（D2：capabilities.baseUrl 上报；容器 compose 设 http://worker）。
# 缺省：worker 启动时自动探测本机非回环 IPv4 上报（跳过 docker/veth/br- 等虚拟网卡；探测失败
# 才回退 http://127.0.0.1——仅本机可访问，server 连不上 → worker 显示不可用）。
# 集群外/跨机 worker 若 server 无法访问探测到的地址（多网卡/VPN 等），请显式设置为
# server 可达的 worker 地址（如 http://<worker 局域网 IP>）。
# WORKER_ADVERTISE_HOST=http://127.0.0.1

# SSH 私钥路径（T5 git 凭证注入：GIT_SSH_KEY_PATH）；空 = 不注入 GIT_SSH_COMMAND
# GIT_SSH_KEY_PATH=/home/keta/.ssh/id_ed25519

# worker 默认模型 id（C2：随注册上报 WORKER_DEFAULT_MODEL，C7 分派兜底）；空 = 未配置不上报
# WORKER_DEFAULT_MODEL=opencode-go/deepseek-v4-flash

# T10 执行端点端口（node:http POST /execute，与 serve 端口解耦）；随注册 capabilities.execPort 上报
# WORKER_EXEC_PORT=4198

# T10 执行端点首字超时 ms（模型时限内无首字输出即 abort；首字出现后无完成超时，长期任务持续等待）
# WORKER_FIRST_TOKEN_TIMEOUT_MS=120000

# worker 最大并发会话数（随注册 capabilities.maxInstances 上报，server 容量调度据此分派）；
# 默认 5（serve 支持多 session 并行，长任务执行中仍可调度新消息）；≤0/非法值兜底 5
# WORKER_MAX_INSTANCES=5
