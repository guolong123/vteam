# ============================================================
# vteam worker（dsh 引擎版）——试用镜像
#
# 与 worker/Dockerfile 的差异：
#   - 基础镜像 node:24（DSH 要求 node >= 24.9；原镜像 node:22 不满足）
#   - 预装 `dsh` CLI（npm 公开发行包，锁版本）+ bubblewrap（linux 沙箱链）
#   - 不装 opencode CLI（dsh 引擎不需要；减小体积与构建时间）
#   - 不装 agent-browser / Chrome（试用期浏览器能力非必需）
#
# 用法（compose 覆盖 worker 服务）：
#   WORKER_ENGINE=dsh
#   DSH_API_KEY=...
#   DSH_PROVIDER/DSH_MODEL/DSH_BASE_URL 按实际路由
# ============================================================
ARG NODE_IMAGE=docker.io/library/node:24-bookworm-slim

# ---- 阶段 1：build（TS 编译）----
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
# 与既有 worker 构建一致的国内源；失败时回退默认源（离线/受限网络）
RUN npm config set registry https://registry.npmmirror.com && npm ci || npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

# ---- 阶段 2：runner ----
FROM ${NODE_IMAGE}
# 与 opencode 版 worker 的运行时能力对齐（多附件放宽格式后，用户可能发压缩包）：
# - unzip/zip/xz-utils：zip/tar.xz 由模型自行解压（原来只有 tar/gzip，zip 解不了）
# - python3：二进制/文档类兜底解析（zipfile、json、csv…），也是 opencode 版已有能力
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git openssh-client curl jq bash procps \
      bubblewrap unzip zip xz-utils python3 \
    && rm -rf /var/lib/apt/lists/*

# dsh CLI（锁版本；升级需同步跑 P7 的 conformance 断言）
ARG DSH_SPEC=@deepseek-ai/dsh@0.2.2-alpha.2
RUN npm config set registry https://registry.npmmirror.com && \
    npm i -g "${DSH_SPEC}" && echo "dsh installed: $(dsh --version)" && which dsh

# ── 沙箱 profile 补丁：bwrap 的 `--proc /proc` 在本集群内核上必然失败 ──────────
# DSH 的 bwrap profile 会新建 PID namespace 并重新挂 procfs；而本集群内核
# （4.18 RHEL8 / 6.5 elrepo）**拒绝在非初始 user namespace 里挂 procfs**
# ⇒ `bwrap: Can't mount proc on /newroot/proc: Operation not permitted`
# ⇒ DSH 探针判 bwrap 不可用 ⇒ 回退 landlock（内核未启用 LSM）⇒ 两后端全挂
# ⇒ 默认 workspace-write 模式下 bash 直接失败，只能 danger-full-access。
# 去掉这两项后：非 root 运行 + 沙箱仍然有效（/etc 只读、仅可写 workspace），
# 是本集群的最小权限解。锚点漂移会**构建失败**（刻意，避免静默失去沙箱）。
COPY scripts/vendor-dsh-sandbox-proc.mjs /app/scripts/vendor-dsh-sandbox-proc.mjs
RUN node /app/scripts/vendor-dsh-sandbox-proc.mjs

WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./

# ── P5 vendor：给 SDK server 补 session/cancel + session/steer ────────────
# 已发布的 SDK server 只有 7 个方法，缺 cancel/steer（P0 实测）。
# 本步骤在**构建期**注入两个 case（幂等；锚点漂移会构建失败而不是运行期静默丢功能）。
COPY scripts/vendor-sdk-server.mjs /app/scripts/vendor-sdk-server.mjs
RUN node /app/scripts/vendor-sdk-server.mjs && echo "SDK server vendored (cancel + steer)"

# 非 root 运行（沙箱前置条件）：bubblewrap 以 **root** 运行时走特权路径，需要
# CAP_SYS_ADMIN（容器默认能力集没有）⇒ `Creating new namespace failed`；
# 以非 root 运行时自动走 user-namespace 路径。chart 侧用 workerDsh.securityContext
# 指定 runAsUser/runAsGroup/fsGroup=1000（= node 官方镜像自带的 node 用户；
# 用自定义 uid 会因 /etc/passwd 无条目触发 `uv_os_get_passwd returned ENOENT`）。
# ⚠️ 这里只建目录不建用户：uid 1000 已存在于基础镜像。

# dsh 运行时 home（隔离；每个 worker 一个）
ENV DSH_HOME_DIR=/data/dsh-home
# 引擎选择（compose 可覆盖）
ENV WORKER_ENGINE=dsh
ENV WORK_DIR=/data/vteam-worker
RUN mkdir -p /data/vteam-worker /data/dsh-home

# 代码版本注入（与 worker/Dockerfile 对齐）：发布流程传 CODE_VERSION=v1.4.0，
# worker 心跳据此上报 CODE_VERSION，控制面能看出"这个节点跑的是哪个发布版本"。
# 优先级见 worker/src/code-version.ts：env WORKER_CODE_VERSION > dist/version.js > 'dev'。
ARG CODE_VERSION=container-unstamped
ENV WORKER_CODE_VERSION=${CODE_VERSION}

# ── PID1 reaper（僵尸进程修复，2026-11-10）──────────────────────────────────
# dsh worker 里 bwrap/bash/子进程同样会产生 reparent 到 PID1 的孤儿；node 作为
# PID1 不 wait() ⇒ 僵尸累积（k8s 无法传 --init，只能由镜像 ENTRYPOINT 保证）。
# 独立小层安装，避免弄脏前面 apt/dsh/SDK vendor 的缓存层。
RUN apt-get update && \
    apt-get install -y --no-install-recommends tini && \
    rm -rf /var/lib/apt/lists/*

EXPOSE 4198
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
