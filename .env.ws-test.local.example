# 多工作空间测试栈（vteam-ws）环境变量示例。
# 复制为 .env.ws-test.local 后使用（该文件已被本地 exclude，不要提交真实密钥）。
MYSQL_ROOT_PASSWORD=vteam-ws-root
# 必填：32 字节随机密钥（openssl rand -hex 32）
MODEL_CREDENTIAL_KEY=
WORKER_TOKEN=ws-test-worker-token
OPENCODE_SERVER_PASSWORD=ws-test-serve-password
JWT_SECRET=ws-test-jwt-secret
# 可选：上传 URL 签名密钥（缺省回落 JWT_SECRET；生产建议独立随机值）
# UPLOAD_URL_SECRET=
# 可选：上传 URL 有效期秒数（默认 180 天）
# UPLOAD_URL_TTL_SECONDS=
# 可选：迁移期关闭上传签名校验（默认开启）
# UPLOAD_URL_SIGNATURE_ENFORCE=false
