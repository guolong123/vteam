# dependencies
node_modules/

# build output
dist/
.next/

# environment
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-error.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# prisma sqlite database (do not commit dev.db)
server/prisma/*.db
