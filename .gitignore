# dependencies
node_modules/

# build output
dist/
.next/

# environment
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-error.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# prisma sqlite database (do not commit dev.db)
server/prisma/*.db
server/prisma/*.db-journal

# typescript build cache
*.tsbuildinfo

# test coverage
coverage/

# playwright mcp runtime artifacts (console logs / page snapshots / screenshots)
.playwright-mcp/

# evidence screenshots (kept in .omo/evidence but not versioned; .md/.txt evidence still tracked)
.omo/evidence/**/*.png
.gstack/

# DB backups (deploy-time mysqldump, hundreds of MB — never versioned).
# NOTE: scoped to .omo/evidence on purpose — prisma migrations (*.sql) MUST stay committable,
# and several legacy evidence .sql backups are already tracked. Do NOT add a blanket *.sql here.
.omo/evidence/**/*.sql

# evidence JSON (jest regenerates probe/matrix evidence → running the test suite dirties the
# working tree; see .omo/plans/pm-coordination-hardening.md item 9 / Batch F).
# NOTE: scoped to .omo/evidence on purpose — package.json / tsconfig.json / chart values /
# e2e evidence JSON elsewhere MUST stay tracked. Do NOT add a blanket *.json here.
# .txt/.md evidence receipts remain tracked.
.omo/evidence/**/*.json

# 冻结基线：断言「基线一致性」的 spec 直接读它们（见
# server/src/execution-policies/__fixtures__/policy-fixtures.ts 的 BLOCKER-1 说明：
# 「基线文件必须随仓库提交，否则干净检出下测试不可复现」）⇒ 必须保持入库，
# 不能被上面那条 *.json 规则吃掉（否则干净检出下 spec 直接 ENOENT 失败）。
!.omo/evidence/vteam-role-behavior-abstraction/before-agent-policies.json
!.omo/evidence/vteam-role-behavior-abstraction/before-boundary.json
!.omo/evidence/opencode-native-permissions-and-fixes/baseline-agent-policies.json

# md-docs: standalone git repo (own remote gitee.com/guojongg/mddocs), not part of this tree
md-docs/

# 本地部署核对留存的运行凭据（登录 JWT / worker token），严禁入库
.omo/evidence/local-compose-deploy/.token
.omo/evidence/local-compose-deploy/login-raw.json

# scratch scripts
*.tmp.cjs

# session snapshots (run-continuation JSON, not versioned)
.omo/run-continuation/

# server runtime uploads (P2 产出物落盘目录，运行时产物不入库)
server/uploads/

# docs-site disk mirror retired (T11: DocsMirrorService deleted, no longer written)
server/docs-root/

# worker 发布包（pack-worker.sh 构建产物，随 web 静态服务发布，不入库）
web/public/worker-src.tar.gz
# 发布包版本元数据（{version,sha256,builtAt}，与上一行同源产物，每次打包重写）
web/public/worker-src.version.json

# deploy-k8s.sh 持久化的 4 个 secret（DB_PASSWORD / JWT / WORKER_TOKEN / MODEL_KEY），
# 不入库；删除后下次 deploy 会重新生成（破坏现有登录态 / MySQL root / worker 注册）
.deploy-secrets.env

# todo-9 clean-rebuild safety backups (contain credentials)
.omo/evidence/**/worker-home-backup/
.omo/evidence/**/*.tgz

# Python bytecode（SDK / 脚本运行产物，不入库）
__pycache__/
*.pyc
