# dependencies
node_modules/

# build output
dist/
.next/

# environment
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-error.log*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# prisma sqlite database (do not commit dev.db)
server/prisma/*.db
server/prisma/*.db-journal

# typescript build cache
*.tsbuildinfo

# test coverage
coverage/

# playwright mcp runtime artifacts (console logs / page snapshots / screenshots)
.playwright-mcp/

# evidence screenshots (kept in .omo/evidence but not versioned; .md/.txt evidence still tracked)
.omo/evidence/**/*.png
.gstack/

# DB backups (deploy-time mysqldump, hundreds of MB — never versioned).
# NOTE: scoped to .omo/evidence on purpose — prisma migrations (*.sql) MUST stay committable,
# and several legacy evidence .sql backups are already tracked. Do NOT add a blanket *.sql here.
.omo/evidence/**/*.sql

# md-docs: standalone git repo (own remote gitee.com/guojongg/mddocs), not part of this tree
md-docs/

# 本地部署核对留存的运行凭据（登录 JWT / worker token），严禁入库
.omo/evidence/local-compose-deploy/.token
.omo/evidence/local-compose-deploy/login-raw.json

# scratch scripts
*.tmp.cjs

# session snapshots (run-continuation JSON, not versioned)
.omo/run-continuation/

# server runtime uploads (P2 产出物落盘目录，运行时产物不入库)
server/uploads/

# docs-site disk mirror retired (T11: DocsMirrorService deleted, no longer written)
server/docs-root/

# worker 发布包（pack-worker.sh 构建产物，随 web 静态服务发布，不入库）
web/public/worker-src.tar.gz

# deploy-k8s.sh 持久化的 4 个 secret（DB_PASSWORD / JWT / WORKER_TOKEN / MODEL_KEY），
# 不入库；删除后下次 deploy 会重新生成（破坏现有登录态 / MySQL root / worker 注册）
.deploy-secrets.env
