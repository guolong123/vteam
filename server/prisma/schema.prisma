// ------------------------------------------------------------------
// AI Agent 协作平台数据模型 — Prisma schema（20 表）
//
// 唯一事实来源：docs/agent-platform/15-数据模型细化（ER图）.md
//   §2  字段类型约定（字符串枚举 + Json 列，规避 SQLite 无原生 enum）
//   §2.2 主键策略（VARCHAR(64) 域前缀 + 自增序号）
//   §3  逐表字段定义（20 表全量）
//   §4/§5 唯一约束与索引
//
// 双库兼容说明（08 篇 §6.2 / 15 篇 §2.1）：
//   Prisma 自 2.22.0 起移除了 datasource provider 数组写法（provider = ["mysql","sqlite"]），
//   同一 datasource 只能声明单一 provider。因此「双库兼容」通过**可移植类型**达成：
//     - 状态/类型/优先级一律 String 列 + 应用层常量（不声明 Prisma enum）
//     - Json 列统一 Prisma Json（SQLite 以 TEXT 存储）
//     - 时间统一 UTC + DateTime
//     - 布尔用 Boolean（SQLite 映射 INTEGER 0/1）
//     - 不使用 @db.VarChar 等 MySQL 专属 native type（SQLite 会拒绝，破坏双库可移植）
//   ⚠️ provider 当前为 "mysql"（生产目标，T2 迁移基线已生成于 migrations/）。
//      本地开发两种方式（择一）：
//        a) 推荐：本地 Docker 起 MySQL（DATABASE_URL 指向 localhost:3306，见 .env.example）
//        b) 回退 SQLite：仅把 provider 改回 "sqlite"，DATABASE_URL="file:./dev.db"，
//           再执行 `npx prisma db push` 重建本地库（dev.db 可随 seed 重建，数据非权威）
//
// 约定：
//   - 外键级联一律 ON DELETE RESTRICT（删除路径由服务层显式编排）
//   - audit_logs 预留表【本版不建】
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================================================================
// 认证 / 用户域
// ==================================================================

model User {
  id           String   @id
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  email        String?  @unique
  roleId       String   @map("role_id")
  enabled      Boolean  @default(true)
  /// 忘记密码一次性重置 token（内网手动传递，无邮件服务），用后即清
  resetToken         String?   @map("reset_token")
  /// 重置 token 过期时间（生成后 30 分钟内有效）
  resetTokenExpires  DateTime? @map("reset_token_expires")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projects       Project[]       @relation("UserProjects")
  projectMembers ProjectMember[]
  taskCreated    Task[]          @relation("TaskCreator")
  agentsCreated  Agent[]         @relation("AgentCreator")

  @@map("users")
}

model Role {
  id          String   @id
  name        String   @unique
  permissions Json
  scopes      Json
  isBuiltin   Boolean  @default(false) @map("is_builtin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

// ==================================================================
// 项目域
// ==================================================================

model Project {
  id          String   @id
  name        String
  description String?
  ownerId     String   @map("owner_id")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User            @relation("UserProjects", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members ProjectMember[]
  tasks   Task[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, userId], map: "uk_project_members_pid_uid")
  @@map("project_members")
}

// ==================================================================
// 任务域
// ==================================================================

model Task {
  id              String    @id
  projectId       String    @map("project_id")
  title           String
  description     String?
  priority        String    @default("medium")
  status          String    @default("pending")
  mainAgentId     String?   @map("main_agent_id")
  backgroundDocs  Json?     @map("background_docs")
  createdBy       String    @map("created_by")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  pendingReviewAt DateTime? @map("pending_review_at")
  completedAt     DateTime? @map("completed_at")
  archivedAt      DateTime? @map("archived_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator            User                @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mainAgent          Agent?              @relation("TaskMainAgent", fields: [mainAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taskAgents         TaskAgent[]
  taskEvents         TaskEvent[]
  sessions           Session[]
  chatChannels       ChatChannel[]
  artifacts          Artifact[]
  taskGroupInstances TaskGroupInstance[]

  @@index([projectId, status], map: "idx_tasks_project_status")
  @@map("tasks")
}

model TaskAgent {
  id        String    @id
  taskId    String    @map("task_id")
  agentId   String    @map("agent_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  removedAt DateTime? @map("removed_at")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([taskId, agentId], map: "uk_task_agents_task_agent")
  @@index([taskId, joinedAt], map: "idx_task_agents_task")
  @@map("task_agents")
}

model TaskEvent {
  id         String   @id
  taskId     String   @map("task_id")
  eventType  String   @map("event_type")
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, createdAt], map: "idx_task_events_task_time")
  @@map("task_events")
}

// ==================================================================
// 会话域
// ==================================================================

model Session {
  id          String    @id
  taskId      String    @map("task_id")
  agentId     String    @map("agent_id")
  workerId    String?   @map("worker_id")
  instanceRef String?   @map("instance_ref")
  status      String    @default("created")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agent  Agent   @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  worker Worker? @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([taskId, agentId], map: "uk_sessions_task_agent")
  @@map("sessions")
}

// ==================================================================
// 群聊域
// ==================================================================

model ChatChannel {
  id         String    @id
  type       String
  taskId     String    @map("task_id")
  agentId    String?   @map("agent_id")
  // UX-09 会话管理（channel 级简化：置顶/已读为频道级标记，非用户粒度——演示平台可接受；
  // 用户级置顶/已读需 ChannelUser 关联表，评估后本期不做）
  pinned     Boolean   @default(false)
  lastReadAt DateTime? @map("last_read_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages Message[]

  @@unique([taskId, agentId], map: "uk_channels_task_agent")
  @@map("chat_channels")
}

model Message {
  id         String   @id
  channelId  String   @map("channel_id")
  senderType String   @map("sender_type")
  senderId   String?  @map("sender_id")
  content    Json
  mentions   Json?
  // UX-10 群聊附件：客户端先 POST /uploads 拿 url，随消息提交（图片/文档均可）
  attachmentUrl    String?  @map("attachment_url")
  attachmentName   String?  @map("attachment_name")
  attachmentType   String?  @map("attachment_type")
  status     String   @default("sent")
  createdAt  DateTime @default(now()) @map("created_at")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([channelId, id], map: "idx_messages_channel_id")
  @@map("messages")
}

// ==================================================================
// 产出物域
// ==================================================================

model Artifact {
  id             String   @id
  taskId         String   @map("task_id")
  type           String
  title          String
  currentVersion Int      @default(0) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  task     Task              @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions ArtifactVersion[]

  @@index([taskId, type], map: "idx_artifacts_task_type")
  @@index([taskId], map: "idx_artifacts_task")
  @@map("artifacts")
}

model ArtifactVersion {
  id            String    @id
  artifactId    String    @map("artifact_id")
  version       Int
  contentRef    String    @map("content_ref")
  filePath      String?   @map("file_path")
  sha256        String?
  acceptedFlag  Boolean   @default(false) @map("accepted_flag")
  authorAgentId String?   @map("author_agent_id")
  changeNote    String?   @map("change_note")
  createdAt     DateTime  @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author   Agent?   @relation("ArtifactAuthor", fields: [authorAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([artifactId, version], map: "uk_artifact_versions_art_ver")
  @@map("artifact_versions")
}

// ==================================================================
// Agent 域
// ==================================================================

model Agent {
  id              String    @id
  name            String
  type            String
  baseAgentId     String?   @map("base_agent_id")
  role            String?
  prompt          String
  defaultModelId  String?   @map("default_model_id")
  // 首选 worker 软绑定（可空，null=自动调度；离线自动回退，Metis R1）
  workerId        String?   @map("worker_id")
  // 群聊 @Agent 收到确认文案（可空，null → 落库用 DEFAULT_ACK_MESSAGE 默认文案）
  ackMessage      String?   @map("ack_message")
  permissionScope Json?     @map("permission_scope")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  baseAgent         Agent?             @relation("AgentClone", fields: [baseAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clones            Agent[]            @relation("AgentClone")
  creator           User               @relation("AgentCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skills            AgentSkill[]
  toolEffects       AgentToolEffect[]
  taskAgents        TaskAgent[]
  sessions          Session[]
  channels          ChatChannel[]
  authoredArtifacts ArtifactVersion[]  @relation("ArtifactAuthor")
  mainTasks         Task[]             @relation("TaskMainAgent")

  @@map("agents")
}

model AgentSkill {
  id        String   @id
  agentId   String   @map("agent_id")
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([agentId, skillId], map: "uk_agent_skills_agent_skill")
  @@map("agent_skills")
}

model AgentToolEffect {
  id         String   @id
  agentId    String   @map("agent_id")
  toolAction String   @map("tool_action")
  effect     String
  updatedAt  DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([agentId, toolAction], map: "uk_agent_tool_effects")
  @@map("agent_tool_effects")
}

// ==================================================================
// 技能工具域
// ==================================================================

model Skill {
  id          String   @id
  name        String   @unique
  description String?
  // SKILL.md 全文（T1 新增列：worker 注入需原文写出，DB 为唯一事实源）
  // F3-1：@db.Text 承载长文档（VARCHAR(191) 导致 >191 字符 SKILL.md 落库 500）
  // ⚠️ 不带 @default：MySQL TEXT 列禁止字面量默认值（P3018/1101），create 必传 content 无需 DB 默认
  content     String   @db.Text
  fileMeta    Json?    @map("file_meta")
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agentSkills AgentSkill[]

  @@map("skills")
}

model Tool {
  id          String   @id
  name        String
  action      String   @unique
  source      String
  execution   String
  mcpServer   String?  @map("mcp_server")
  schema      Json?
  initCommand Json?    @map("init_command")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("tools")
}

// ==================================================================
// 模型目录域（C1：models 目录 + worker 可用性映射；15 篇 §2.2 域前缀 md_）
// ==================================================================

model Model {
  id           String    @id
  providerID   String    @map("provider_id")
  modelID      String    @map("model_id")
  name         String
  capabilities Json?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workerAvailabilities WorkerModelAvailability[]

  @@unique([providerID, modelID], map: "uk_models_provider_model")
  @@map("models")
}

model WorkerModelAvailability {
  workerId String @map("worker_id")
  modelId  String @map("model_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model  Model  @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([workerId, modelId])
  @@map("worker_model_availabilities")
}

// ==================================================================
// 模型凭据域（C4：provider token 加密存储；17 篇 §3.4 AES-256-GCM 基线）
// ==================================================================

model ModelCredential {
  id            String    @id
  // token 全局 provider 粒度（关键决策①）——凭据按 providerID 关联，不建 FK
  // （models.provider_id 非唯一，逻辑关联经 ModelsService 查询 provider 解析）
  providerID    String    @map("provider_id")
  // AES-256-GCM 加密后的 token 引用（明文零接触：不进日志/审计事件/响应）
  credentialRef String    @db.Text @map("credential_ref")
  // 脱敏标识（如 sk-****abc，fingerprint 不进日志/审计事件/响应）
  fingerprint   String
  // 软撤销（吊销 = 软删，保留审计轨迹；同 provider 重复 POST 覆盖更新时清除）
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([providerID], map: "uk_model_credentials_provider")
  @@map("model_credentials")
}

// ===== git 仓库凭证域（17 篇《仓库权限与凭证机制》§3.1/§3.2，B 方案落地）=====

model GitCredential {
  id            String    @id
  // repoUrl 逻辑关联（不建 FK：repo 跨仓库/命名空间解析，仿 ModelCredential 无 FK 模式）
  repoUrl       String    @map("repo_url")
  // 认证方式：ssh_key | https_token（credentialRef 仅存 AES-256-GCM 密文引用，明文零接触）
  authType      String    @map("auth_type")
  credentialRef String    @db.Text @map("credential_ref")
  // 脱敏标识（如 ssh-rsa AAAA**** / gh_****，不进日志/审计事件/响应）
  fingerprint   String
  // 操作者（管理员 id），保留审计轨迹
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // 软撤销（吊销 = 软删，保留审计轨迹；同 repo+authType 重复 POST 覆盖更新时清除）
  revokedAt     DateTime? @map("revoked_at")

  @@unique([repoUrl, authType], map: "uk_git_credentials_repo_auth")
  @@map("git_credentials")
}

model GitRepoGrant {
  id         String    @id
  // agentId 逻辑关联（不建 FK：agents 域主键，Agent 生命周期独立）
  // subject_type 预留：role/project 粒度授权不引入字段（B 方案仅 agent 粒度，注释预留）
  agentId    String    @map("agent_id")
  repoUrl    String    @map("repo_url")
  // permission: read | write（write 含 read 能力；git_push 需 write）
  permission String
  // effect: allow | ask（ask = 默认成员确认后放行）
  effect     String
  // 授权人（管理员 id），保留授权轨迹
  grantedBy  String    @map("granted_by")
  grantedAt  DateTime  @default(now()) @map("granted_at")
  // 软撤销（吊销 = 软删，保留授权轨迹）
  revokedAt  DateTime? @map("revoked_at")

  @@unique([agentId, repoUrl], map: "uk_git_repo_grants_agent_repo")
  @@index([agentId], map: "idx_git_repo_grants_agent")
  @@index([repoUrl], map: "idx_git_repo_grants_repo")
  @@map("git_repo_grants")
}

// ==================================================================
// MCP 服务器域（11 篇 §5.1 / §5.8：mcp_servers 实体，T8a）
// ==================================================================

model McpServer {
  id        String   @id
  name      String   @unique
  type      String // local | remote（11 篇 §5.1 两型）
  command   Json? // local：{command[], cwd?, environment?, timeout?}
  url       String? // remote：合法 http(s) URL
  headers   Json? // remote：{header: value}
  oauth     Json? // remote：{clientId?, clientSecret?, scope?} 或 false（显式禁用）
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mcp_servers")
}

// ==================================================================
// Worker 域
// ==================================================================

model Worker {
  id              String    @id
  name            String?
  opencodeVersion String    @map("opencode_version")
  capabilities    Json
  load            Json?
  status          String    @default("offline")
  // worker 默认模型兜底（分派时 Agent 未配模型 → 用执行 worker 默认模型，C8）
  defaultModelId  String?   @map("default_model_id")
  tokenHash       String?   @map("token_hash")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  registeredAt    DateTime  @default(now()) @map("registered_at")

  sessions           Session[]
  taskGroupInstances TaskGroupInstance[]
  modelAvailabilities WorkerModelAvailability[]

  @@index([status, lastHeartbeatAt], map: "idx_workers_status_heartbeat")
  @@map("workers")
}

model TaskGroupInstance {
  id         String    @id
  taskId     String    @map("task_id")
  workerId   String    @map("worker_id")
  instanceId String    @map("instance_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  removedAt  DateTime? @map("removed_at")

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("task_group_instances")
}

// ==================================================================
// 实时事件域
// ==================================================================

model RealtimeEvent {
  id        String   @id
  type      String
  scopeType String   @map("scope_type")
  scopeId   String?  @map("scope_id")
  projectId String?  @map("project_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([scopeType, scopeId, id], map: "idx_realtime_events_scope_id")
  @@index([projectId], map: "idx_realtime_events_project_id")
  @@map("realtime_events")
}