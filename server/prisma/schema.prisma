// ------------------------------------------------------------------
// AI Agent 协作平台数据模型 — Prisma schema（21 表）
//
// 唯一事实来源：docs/agent-platform/15-数据模型细化（ER图）.md
//   §2  字段类型约定（字符串枚举 + Json 列，规避 SQLite 无原生 enum）
//   §2.2 主键策略（VARCHAR(64) 域前缀 + 自增序号）
//   §3  逐表字段定义（21 表全量）
//   §4/§5 唯一约束与索引
//
// 双库兼容说明（08 篇 §6.2 / 15 篇 §2.1）：
//   Prisma 自 2.22.0 起移除了 datasource provider 数组写法（provider = ["mysql","sqlite"]），
//   同一 datasource 只能声明单一 provider。因此「双库兼容」通过**可移植类型**达成：
//     - 状态/类型/优先级一律 String 列 + 应用层常量（不声明 Prisma enum）
//     - Json 列统一 Prisma Json（SQLite 以 TEXT 存储）
//     - 时间统一 UTC + DateTime
//     - 布尔用 Boolean（SQLite 映射 INTEGER 0/1）
//     - 不使用 @db.VarChar 等 MySQL 专属 native type（SQLite 会拒绝，破坏双库可移植）
//   ⚠️ provider 当前为 "mysql"（生产目标，T2 迁移基线已生成于 migrations/）。
//      本地开发两种方式（择一）：
//        a) 推荐：本地 Docker 起 MySQL（DATABASE_URL 指向 localhost:3306，见 .env.example）
//        b) 回退 SQLite：仅把 provider 改回 "sqlite"，DATABASE_URL="file:./dev.db"，
//           再执行 `npx prisma db push` 重建本地库（dev.db 可随 seed 重建，数据非权威）
//
// 约定：
//   - 外键级联一律 ON DELETE RESTRICT（删除路径由服务层显式编排）
//   - audit_logs 预留表【本版不建】
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================================================================
// 认证 / 用户域
// ==================================================================

model User {
  id                String    @id
  username          String    @unique
  passwordHash      String    @map("password_hash")
  displayName       String    @map("display_name")
  email             String?   @unique
  roleId            String    @map("role_id")
  enabled           Boolean   @default(true)
  /// 忘记密码一次性重置 token（内网手动传递，无邮件服务），用后即清
  resetToken        String?   @map("reset_token")
  /// 重置 token 过期时间（生成后 30 分钟内有效）
  resetTokenExpires DateTime? @map("reset_token_expires")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taskCreated    Task[]          @relation("TaskCreator")
  agentsCreated  Agent[]         @relation("AgentCreator")
  assignedIssues Issue[]         @relation("IssueAssigneeUser")
  createdIssues  Issue[]         @relation("IssueCreatorUser")
  teamsCreated   Team[]          @relation("TeamCreator")
  teamUserMembers TeamUserMember[]

  @@map("users")
}

model Role {
  id          String   @id
  name        String   @unique
  permissions Json
  scopes      Json
  isBuiltin   Boolean  @default(false) @map("is_builtin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

// ==================================================================
// 团队域（全局团队 + FIFO 排队，vteam-team-refactor expand 阶段）
// ==================================================================

model Team {
  id                 String   @id
  name               String   @unique
  description        String?  @db.Text
  reuseSession       Boolean  @default(true) @map("reuse_session")
  // 托管模式（session-unification Todo 6/9：从 tasks.managedMode 迁入，按团队行读取）
  managedMode        Boolean  @default(false) @map("managed_mode")
  currentTaskId      String?  @map("current_task_id")
  mainAgentMemberId  String?  @map("main_agent_member_id")
  version            Int      @default(0) @map("version")
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  creator      User          @relation("TeamCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentTask  Task?         @relation("TeamCurrentTask", fields: [currentTaskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mainAgentMember TeamMember? @relation("TeamMainAgent", fields: [mainAgentMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members      TeamMember[]
  userMembers  TeamUserMember[]
  sessions     Session[]
  taskGroupInstances TaskGroupInstance[]
  queues       TeamQueue[]
  tasks        Task[]        @relation("TaskTeam")
  chatChannels ChatChannel[]
  messageChannelLinks TeamMessageChannel[]
  notificationChannelLinks TeamNotificationChannel[]

  @@index([mainAgentMemberId], map: "idx_teams_main_agent_member")
  @@map("teams")
}

/// Agent 角色（全局可复用岗位；agent-role-entity 计划 Wave-1）。
///
/// ⚠️ 与 account-permission 的 `Role`（`schema.prisma` 顶部，`@@map("roles")`）无关：
/// 本模型映射 `agent_roles`，主键前缀 `ar`（见 `src/common/constants/agent-role.constants.ts`
/// 的 AGENT_ROLE_ID_PREFIX）。禁止把本模型命名为 `Role` 或映射到 `roles`。
///
/// 唯一能力字段是 `capabilities`（岗位的**业务能力点矩阵**）：它是服务端 `vteam_*` 调用
/// 授权的权威来源（成员 `roleId` → `capabilities` → 能力点 `false` 则 403）。执行 Agent 的
/// 引擎原生权限（permission/tools/model/worker）仍属 ExecutionPolicy / Agent，与岗位解耦
/// （2026-09-21：`policyId` 间接层已移除）。
model AgentRole {
  id          String   @id
  /// machine-safe 唯一标识（`^[a-z][a-z0-9_-]{0,62}$`）：内置=模板 role（product/…），
  /// 自定义由服务层校验；回填派生的自定义 key 见 migration 的确定性规则。
  key         String   @unique(map: "uk_agent_roles_key")
  name        String
  description String?  @db.Text
  /// 'builtin'（seed 的 7 个模板角色）| 'custom'（用户创建 / 回填派生）。
  /// 与 Agent.type / ExecutionPolicy.type 同风格：String 承载，不引 Prisma enum（sqlite 测试兼容）。
  type        String
  /// 预填默认 Agent（内部，可选）。删除被绑定的 Agent 时仅清空本列（SetNull），
  /// 不阻塞 Agent 删除（review fix m8）。回填不设置本列，仅 7 个 builtin 行指向模板 Agent。
  ///
  /// 与 `defaultOpencodeAgentName` **互斥**：一个角色至多绑定一个默认 Agent 槽位
  /// （内部 id 或外部引擎名）。写入侧由 AgentRolesService 强制（两者同时非空 → 400
  /// `AGENT_ROLE_DEFAULT_SLOT_CONFLICT`；设置其一自动清空另一个），二者皆空亦合法。
  defaultAgentId String? @map("default_agent_id")
  /// 预填默认**外部引擎** Agent 名（opencode agent 名，如 `Prometheus - Plan Builder`；
  /// 含空格/大写，原样保存不裁剪内容）。与 `defaultAgentId` 互斥，规则见上一字段注释。
  defaultOpencodeAgentName String? @map("default_opencode_agent_name")
  /// 岗位**业务能力点矩阵**（2026-09-21 role-owned capability model）：`Record<string, boolean>`，
  /// 键为 `platform-capability.constants.ts` 目录的 capability key（如 `task.create`）。
  /// **显式 `false` ⇒ 拒绝；缺失键 ⇒ 允许（default-allow）**。这是服务端 `vteam_*` 调用
  /// 授权（`PlatformToolPermissionService.assertToolAllowed`）的**唯一权威来源**：
  /// 成员 `roleId` → 本列 → 工具裸名映射能力点 → `false` 则 403。
  /// 可空仅为兼容未写矩阵的行；`null` 等同 `{}`（全放行），故 migration/seed 保证出厂行非空。
  /// 执行 Agent 的引擎原生权限（edit/read/bash/task）仍在 `Agent.policyId`，与本列无关。
  capabilities Json?   @map("capabilities")
  /// 角色指令（"这个岗位是什么"）。列级可空（todo 4 前 builtin 行暂空），
  /// 但每个 builtin 行最终必须非空（todo 4 填充 role_prompt）。
  rolePrompt  String?  @db.Text @map("role_prompt")
  /// 稳定排序（列表展示；内置按 role 序 1..7，回填派生的自定义行沿用 100+）。
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  defaultAgent Agent?       @relation("AgentRoleDefaultAgent", fields: [defaultAgentId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  members      TeamMember[]

  @@index([defaultAgentId], map: "idx_agent_roles_default_agent")
  @@index([sortOrder], map: "idx_agent_roles_sort_order")
  @@map("agent_roles")
}

model TeamMember {
  id             String   @id
  teamId         String   @map("team_id")
  agentId        String   @map("agent_id")
  alias          String?
  seq            Int      @default(1)
  workDir        String?  @map("work_dir")
  overrideModelId String? @map("override_model_id")
  /// 成员角色（agent_roles）。onDelete: Restrict —— 在用角色不可静默删除，
  /// 必须先解绑成员再删角色（FK 报错即显式拦截，绝不静默置空）。
  roleId         String?  @map("role_id")
  /// opencode 原生 agent 名（opencode.json 的 agent 节 key，如 build/plan/自定义名）。
  /// null = 不指定（prompt_async 不带 agent 字段，用 serve 默认 agent）——存量行 NULL 行为不变。
  /// 非 null 时 dispatch 下发 prompt_async 的 agent 字段，由 opencode 内核按该 agent 的
  /// prompt/permission 执行（vteam 只传递，不自造 agent 语义）。
  opencodeAgentName String? @map("opencode_agent_name")
  createdAt      DateTime @default(now()) @map("created_at")

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role         AgentRole?    @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions     Session[]
  taskGroupInstances TaskGroupInstance[]
  chatChannels ChatChannel[]
  mainForTeams Team[]        @relation("TeamMainAgent")

  @@index([roleId], map: "idx_team_members_role")
  @@unique([teamId, agentId, seq], map: "uk_team_members_team_agent_seq")
  @@map("team_members")
}

model TeamQueue {
  id         String   @id
  teamId     String   @map("team_id")
  taskId     String   @unique @map("task_id")
  position   Int
  enqueuedAt DateTime @default(now()) @map("enqueued_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([teamId, position], map: "idx_team_queues_team_position")
  @@map("team_queues")
}

model TeamUserMember {
  id       String   @id
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     String
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([teamId, userId], map: "uk_team_user_members_team_user")
  @@map("team_user_members")
}

// ==================================================================
// 任务域
// ==================================================================

model Task {
  id                  String    @id
  title               String
  // 任务描述可能超过 VARCHAR(191)，TEXT 承载（K8s 部署 500：value too long for column description）
  description         String?   @db.Text
  priority            String    @default("medium")
  status              String    @default("pending")
  mainAgentId         String?   @map("main_agent_id")
  mainAgentInstanceId String?   @map("main_agent_instance_id") // 主 Agent 实例（决策依据，T2 起维护；session-unification 后停止写入，历史值由 Todo 6 迁移置空，列保留）
  // @deprecated 不再读写：Todo 34 已移除 TS 侧写入与读路径回显；列保留待删，物理 DROP 见 W6 迁移（Todo 38）。
  executionMode       String    @default("direct") @map("execution_mode")
  backgroundDocs      Json?     @map("background_docs")
  /// 完成后为下一任务开新会话（覆盖 Team.reuseSession，默认 false，Todo7）
  resetAfterComplete  Boolean   @default(false) @map("reset_after_complete")
  createdBy           String    @map("created_by")
  version             Int       @default(0)
  teamId              String?   @map("team_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  startedAt           DateTime? @map("started_at")
  pendingReviewAt     DateTime? @map("pending_review_at")
  completedAt         DateTime? @map("completed_at")
  archivedAt          DateTime? @map("archived_at")

  creator                  User                      @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mainAgent                Agent?                    @relation("TaskMainAgent", fields: [mainAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  team                     Team?                     @relation("TaskTeam", fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentInTeams           Team[]                    @relation("TeamCurrentTask")
  queue                    TeamQueue?
  taskEvents               TaskEvent[]
  sessions                 Session[]
  chatChannels             ChatChannel[]
  messages                 Message[]
  artifacts                Artifact[]
  taskGroupInstances       TaskGroupInstance[]
  issues                   Issue[]
  memories                 Memory[]
  // 2026-09-24 订正：上条"plan 域下线"已过时——plans/plan_tasks 均为 live 表，业务层经
  // PlanLifecycleService/PlanStepsService 读写；关系保留（见 Plan 模型注释）。
  plan                     Plan?
  messageChannelLinks      TaskMessageChannel[]
  notificationChannelLinks TaskNotificationChannel[]

  @@index([teamId, status], map: "idx_tasks_team_status")
  @@map("tasks")
}

// 团队成员 = 实例（同一模板 agent 在任务内可多实例，seq 服务端生成防并发重号）
// session-unification Todo 6：TaskAgent 模型已删除（迁移 DROP TABLE task_agents）。
// 反向关系同步删除：Task.taskAgents / Agent.taskAgents / Session.taskAgent。
// 保留：tasks.main_agent_instance_id 纯字符串列（历史值已置空）；
// 冻结：uk_sessions_task_agent 约束保留（Session 模型内注释，存量 task 会话行只删不回填）。
model TaskEvent {
  id         String   @id
  taskId     String   @map("task_id")
  eventType  String   @map("event_type")
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, createdAt], map: "idx_task_events_task_time")
  @@map("task_events")
}

// ==================================================================
// 会话域
// ==================================================================

model Session {
  id           String   @id
  taskId       String?  @map("task_id")
  taskAgentId  String?  @map("task_agent_id") // 绑任务实例（每实例独立会话；team-mode 下可空）
  teamId       String?  @map("team_id") // team-mode 执行上下文（nullable 便于存量回填；业务层 team-mode 必填）
  agentId      String   @map("agent_id") // 保留（角色渲染/模型解析），不再是唯一键维度
  teamMemberId String?  @map("team_member_id")
  // team-mode 幂等键承载列（STORED 生成列：task_id 为空时 = team_id|team_member_id，其余为 NULL；DB 唯一索引仅约束 task-less 行，task 绑定行沿用 uk_sessions_task_agent）
  // @db.VarChar(384)：对齐 20260904000000 迁移实际 DDL（VARCHAR(384) 生成列）；
  // 之前无长度声明（默认 191）与库漂移，导致 migrate dev 误提无关 ALTER（P3 skill 版本迁移前置修复，只对齐类型，不碰生成表达式）。
  teamMemberKey String?  @db.VarChar(384) @map("team_member_key")
  workerId     String?  @map("worker_id")
  instanceRef  String?  @map("instance_ref")
  status       String   @default("created")
  // trigger-unification todo-7：空闲判死 DB sidecar（ingress touchSessionActivity +
  // dispatcher handleSessionActivity/watchdog 起点双写；scanIdleSessions 按
  // status='running' AND lastActivityAt < cutoff 检出，重启后内存 map 为空仍可判死；
  // NULL = 迁移前存量行（不命中 lt 比较，不误杀）。内存 pending/active 否决保留（todo-21 前不删）。
  lastActivityAt DateTime? @map("last_activity_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agent      Agent       @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  worker     Worker?     @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // session-unification Todo 6：TaskAgent 模型已删，taskAgent 关系同步删除；
  // task_agent_id 纯字符串列保留（历史残留只读，迁移不回填）；uk_sessions_task_agent 见下冻结注释。
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // FROZEN (session-unification Todo 6)：uk_sessions_task_agent 约束保留冻结——存量 task 会话行只删不回填，
  // 新写路径恒 taskId/taskAgentId=null（Todo 4/10 已收敛），本约束不再承载新语义，不得删除或复用。
  @@unique([taskId, taskAgentId], map: "uk_sessions_task_agent")
  @@unique([teamMemberKey], map: "uk_sessions_team_member")
  @@index([teamId], map: "idx_sessions_team_id")
  // trigger-unification todo-7：空闲判死扫描谓词（status='running' AND last_activity_at < cutoff）。
  @@index([status, lastActivityAt], map: "idx_sessions_status_last_activity")
  @@map("sessions")
}

// ==================================================================
// 群聊域
// ==================================================================

model ChatChannel {
  id           String    @id
  type         String
  teamId       String?   @map("team_id")
  teamMemberId String?   @map("team_member_id")
  taskId       String?   @map("task_id")
  agentId      String?   @map("agent_id") // 保留（角色渲染），不再是唯一键维度
  taskAgentId  String?   @map("task_agent_id") // 私聊频道绑实例；task_group 频道两者均为 NULL（存量兼容)
  // team_group 单例保障：team_group_key 仅 team_group 且未删除时等于 teamId，其余为 NULL，配合唯一索引保证每 team 仅一条 team_group
  teamGroupKey String?   @map("team_group_key")
  // UX-09 会话管理（channel 级简化：置顶/已读为频道级标记，非用户粒度——演示平台可接受；
  // 用户级置顶/已读需 ChannelUser 关联表，评估后本期不做）
  pinned       Boolean   @default(false)
  lastReadAt   DateTime? @map("last_read_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agent      Agent?      @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages   Message[]

  @@unique([teamId, teamMemberId], map: "uk_channels_team_member")
  @@unique([taskId, taskAgentId], map: "uk_channels_task_agent")
  @@unique([teamGroupKey], map: "uk_channels_team_group_single")
  @@index([teamId], map: "idx_chat_channels_team_id")
  @@index([teamId, type], map: "idx_chat_channels_team_type")
  @@map("chat_channels")
}

model Message {
  id               String   @id
  channelId        String   @map("channel_id")
  taskId           String?  @map("task_id")
  senderType       String   @map("sender_type")
  senderId         String?  @map("sender_id")
  senderInstanceId String?  @map("sender_instance_id") // 消息精确归属实例（agent sender 时为 ta_ 实例 id）
  content          Json
  mentions         Json?
  // UX-10 群聊附件：客户端先 POST /uploads 拿 url，随消息提交（图片/文档均可）
  attachmentUrl    String?  @map("attachment_url")
  attachmentName   String?  @map("attachment_name")
  attachmentType   String?  @map("attachment_type")
  status           String   @default("sent")
  createdAt        DateTime @default(now()) @map("created_at")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task    Task?       @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([channelId, id], map: "idx_messages_channel_id")
  @@index([taskId, createdAt], map: "idx_messages_task_created")
  @@index([channelId, taskId], map: "idx_messages_channel_task")
  @@map("messages")
}

// ==================================================================
// 派发回执域（31 篇 §3.1：dispatch 建待回执账，目标回执/完工清账并唤醒派发人一次，
// 超时催办幂等；mr_ 前缀主键；status/kind 字符串枚举 + 应用层常量，
// 双库兼容——不声明 Prisma enum；id 列均为逻辑关联（不建 FK），不碰其他表）
// ==================================================================

// 待回执账本（一派发一账；dedupKey 输入规范（is_5 起）=
// `from::to::sha1(内容去空白后前64字符)`，永不 NULL，issueId 不再参与组键；
// kind=wake/round-notify 为保留位，永不写入，仅防未来误用）
model MessageReceipt {
  id             String    @id // mr_ 前缀，服务层 IdGeneratorService 生成
  messageId      String    @map("message_id") // 触发派发的源消息（notify 落库的那条）
  fromInstanceId String    @map("from_instance_id") // 派发人实例
  toInstanceId   String    @map("to_instance_id") // 目标实例
  taskId         String?   @map("task_id") // 归属任务（团队维度可空）
  teamId         String    @map("team_id") // 归属团队
  // 事项摘要（派发词前 100 字，展示用）
  summary        String    @db.Text
  status         String    @default("pending") // pending|acked|expired
  dedupKey       String    @unique @map("dedup_key")
  issueId        String?   @map("issue_id") // 派发宿主 issue（轮次宿主，null=无宿主）
  nudgeCount     Int       @default(0) @map("nudge_count")
  lastNudgedAt   DateTime? @map("last_nudged_at")
  expiresAt      DateTime  @map("expires_at")
  kind           String    @default("dispatch") // dispatch|wake|round-notify（后两者保留位永不写入）
  forceReason    String?   @map("force_reason") // force 绕过审计原因
  createdAt      DateTime  @default(now()) @map("created_at")
  ackedAt        DateTime? @map("acked_at") // 清账时间

  @@index([toInstanceId, status], map: "idx_message_receipts_to_status")
  @@index([teamId, status], map: "idx_message_receipts_team_status")
  // reply-join drain 检查覆盖索引（countPendingFor: fromInstanceId+teamId+status）
  @@index([fromInstanceId, teamId, status], map: "idx_message_receipts_from_status")
  @@map("message_receipts")
}

// ==================================================================
// 通用触发器域（generic-trigger：前身 generic-timer；tmr_ 前缀主键冻结，
// 不引入 trg_ 前缀；status/kind 字符串枚举 + 应用层常量
// timers/trigger.service.ts TRIGGER_STATUS，双库兼容——不声明 Prisma
// enum；id 列均为逻辑关联（不建 FK），不碰其他表）
//
// 用途：任何功能无需自持时钟即可安排未来触发——schedule(kind, dueAt,
// payload, dedupKey, opts?) 落 pending 行，ticker 到期 claim 后按 kind
// 分发到注册 handler。消费者：receipt-timeout auto-nudge（`receipt_nudge`
// kind，由 chat 域注册）；评审轮次超时（`review_round_timeout` kind）。
// dedupKey 输入规范 = `kind:scope:id`（如 `receipt_nudge:team_1:mr_2`），
// 永不 NULL（nullable unique 在部分 DB 下破坏幂等）；调用方显式传 key。
//
// 三形态（todo-2 trigger-unification）：
// - one-shot：`dueAt` 到期触发一次（历史 `fireAt` 双写保留，后续清理任务再 drop）；
// - interval：`intervalMs` + `nextFireAt` 周期重排（按 now 重算，不追补 missed 周期）；
// - condition：`guardKey` 仅接受已注册谓词（registerGuard 白名单，非任意字符串）。
// ==================================================================

model Trigger {
  id              String    @id // tmr_ 前缀冻结，服务层 IdGeneratorService 生成
  kind            String // handler 注册键（TRIGGER_KIND 白名单，服务层强制）
  status          String    @default("pending") // pending|firing|fired|cancelled|failed
  fireAt          DateTime  @map("fire_at") // 历史列：双写保留，清理前勿删
  dueAt           DateTime? @map("due_at") // one-shot 到期时刻（读路径唯一真相）
  scopeType       String?   @map("scope_type") // 归属域（如 team/issue，可空）
  scopeId         String?   @map("scope_id") // 归属 id（可空）
  ownerInstanceId String?   @map("owner_instance_id") // 拥有实例（可空）
  intervalMs      Int?      @map("interval_ms") // interval 周期（ms，可空）
  nextFireAt      DateTime? @map("next_fire_at") // interval 下次触发（可空）
  guardKey        String?   @map("guard_key") // condition 谓词键（注册白名单，可空）
  fireCount       Int       @default(0) @map("fire_count") // 已触发次数
  maxFires        Int?      @map("max_fires") // 上限（基座强制，handler 不可绕过）
  expiresAt       DateTime? @map("expires_at") // 过期时刻（基座强制，handler 不可绕过）
  skipReason      String?   @map("skip_reason") // guard 未通过等跳过原因
  busyRetries     Int       @default(0) @map("busy_retries") // claim 争用重试计数
  payload         Json // plain JSON，handler 入参 { id, kind, payload }
  dedupKey        String    @unique @map("dedup_key") // `kind:scope:id`，幂等重排键
  attempts        Int       @default(0) @map("attempts")
  lastError       String?   @map("last_error") // handler 抛错/无 handler 时记录
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, fireAt], map: "idx_timers_status_fire_at")
  @@index([status, dueAt], map: "idx_triggers_status_due_at")
  @@map("triggers")
}

// ==================================================================
// Agent hook 域（trigger-unification todo-11：agent 自助"稍后唤醒"，
// hks_ 前缀主键冻结，经共享 IdGeneratorService 生成；status/kind 字符串
// 枚举 + 应用层常量 triggers/hook.service.ts HOOK_STATUS，双库兼容——
// 不声明 Prisma enum；id 列均为逻辑关联（不建 FK），不碰其他表）
//
// 用途：agent 注册"wake me in 4 hours"（time）或"wake me when the team
// goes quiet"（all_idle），结束本轮后由平台在同会话内唤醒（kind:'wake'）。
// time hook 落 hook_fire 触发器行（dueAt 到期唤醒）；all_idle 由全局
// hook_poll interval 行统一扫描（非 per-hook 轮询），到期兜底 hook_fire
// 行定于 expiresAt。血缘：parentHookId 指向上游，rootTaskId 继承不重置。
// ==================================================================

model Hook {
  id              String    @id // hks_ 前缀冻结，服务层 IdGeneratorService 生成
  scopeType       String    @map("scope_type") // 归属域（team/task，all_idle 静默评估域）
  scopeId         String    @map("scope_id") // 归属 id
  ownerInstanceId String    @map("owner_instance_id") // 注册实例（tmm_ 前缀，todo-12 hook_register 服务端写入）
  kind            String // time | all_idle（HOOK_KIND 白名单，服务层强制）
  wakeText        String    @map("wake_text") @db.Text // 唤醒词（2000 字截断，前缀 [hook:<kind> <id>] 在触发时组装）
  target          Json // { taskId?, teamId?, channelId, targetInstanceId }（触发时重解析，失效即 expired）
  status          String    @default("pending") // pending|fired|expired|cancelled
  dueAt           DateTime? @map("due_at") // time 到期时刻（all_idle 为 NULL，走全局 poll）
  graceMs         Int?      @map("grace_ms") // all_idle 静默宽限（NULL → HOOK_ALL_IDLE_GRACE_MS_DEFAULT）
  expiresAt       DateTime  @map("expires_at") // 过期时刻（触发器侧 + handler 侧双重结算）
  dedupKey        String    @unique @map("dedup_key") // `hook:<scope>:<id>`，幂等注册键
  fireCount       Int       @default(0) @map("fire_count") // 已唤醒次数
  busyRetries     Int       @default(0) @map("busy_retries") // busy 否决/分派失败重试计数（todo-19：满 10 次改判 expired）
  parentHookId    String?   @map("parent_hook_id") // 被唤醒轮内注册的新 hook 指向上游（链不断）
  rootTaskId      String?   @map("root_task_id") // 链首任务（继承不重置；resetAfterComplete 按此列标 expired）
  lastError       String?   @map("last_error") // 目标失效/分派失败记录（VARCHAR(191) 上限截断）
  skipReason      String?   @map("skip_reason") // veto/跳过原因（否决必写）
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, dueAt], map: "idx_hooks_status_due_at")
  @@index([status, scopeType, scopeId], map: "idx_hooks_status_scope")
  @@index([status, kind], map: "idx_hooks_status_kind")
  @@index([rootTaskId, status], map: "idx_hooks_root_task_status")
  @@map("hooks")
}

// ==================================================================
// 产出物域
// ==================================================================

model Artifact {
  id             String   @id
  taskId         String   @map("task_id")
  type           String
  title          String
  category       String?
  currentVersion Int      @default(0) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  task     Task              @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions ArtifactVersion[]

  @@index([taskId, type], map: "idx_artifacts_task_type")
  @@index([taskId, category], map: "idx_artifacts_task_category")
  @@index([taskId], map: "idx_artifacts_task")
  @@map("artifacts")
}

model ArtifactVersion {
  id            String   @id
  artifactId    String   @map("artifact_id")
  version       Int
  contentRef    String   @map("content_ref") @db.Text
  filePath      String?  @map("file_path")
  sha256        String?
  acceptedFlag  Boolean  @default(false) @map("accepted_flag")
  authorAgentId String?  @map("author_agent_id")
  changeNote    String?  @map("change_note")
  createdAt     DateTime @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author   Agent?   @relation("ArtifactAuthor", fields: [authorAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([artifactId, version], map: "uk_artifact_versions_art_ver")
  @@map("artifact_versions")
}

// ==================================================================
// Issue 域（任务内 issue 管理）
// ==================================================================

model Issue {
  id                 String    @id
  taskId             String    @map("task_id")
  title              String
  // issue 描述可能超过 VARCHAR(191)，TEXT 承载（同类预防：issue 描述超长报数据库列限制）
  description        String?   @db.Text
  status             String    @default("open")
  tags               Json?     @map("tags")
  assigneeAgentId    String?   @map("assignee_agent_id")
  assigneeInstanceId String?   @map("assignee_instance_id") // 指派到具体任务实例（优先于 assigneeAgentId）
  assigneeUserId     String?   @map("assignee_user_id")
  // 创建者二选一（Metis B1）：用户经 web/API 创建填 createdBy；
  // Agent 经 MCP 创建填 creatorAgentId（createdBy 留空），对齐 Message.senderType/senderId 模式
  createdBy          String?   @map("created_by")
  creatorAgentId     String?   @map("creator_agent_id")
  deletedAt          DateTime? @map("deleted_at")
  resolvedAt         DateTime? @map("resolved_at")
  closedAt           DateTime? @map("closed_at")
  // 拒绝处理态（is_0000000013）：reject 流转必填原因，落 rejectReason；reopen 回 open 时清空
  rejectReason       String?   @map("reject_reason")
  rejectedAt         DateTime? @map("rejected_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  task          Task            @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assigneeAgent Agent?          @relation("IssueAssigneeAgent", fields: [assigneeAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assigneeUser  User?           @relation("IssueAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creatorAgent  Agent?          @relation("IssueCreatorAgent", fields: [creatorAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creatorUser   User?           @relation("IssueCreatorUser", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activities    IssueActivity[]

  @@index([taskId, status], map: "idx_issues_task_status")
  @@index([assigneeAgentId], map: "idx_issues_assignee_agent")
  @@map("issues")
}

// issue 操作记录（is_0000000013）：状态流转/编辑/创建轨迹，含操作人（user 走 userId，agent 走实例 id）
model IssueActivity {
  id         String   @id
  issueId    String   @map("issue_id")
  action     String // create | update | transition
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  actorType  String   @map("actor_type") // user | agent
  actorId    String?  @map("actor_id") // userId 或 agent 实例 id（ta_）
  instanceId String?  @map("instance_id") // agent 操作时的 ta_ 实例 id
  metadata   Json? // { reason? }（拒绝原因）/ { fields? }（编辑变更字段，可选）
  createdAt  DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([issueId, createdAt], map: "idx_issue_activities_issue_time")
  @@map("issue_activities")
}

// ==================================================================
// Agent 域
// ==================================================================

model Agent {
  id              String   @id
  name            String
  type            String
  baseAgentId     String?  @map("base_agent_id")
  /// machine-safe 标识；opencode agent 名 = `vteam-<agentKey>`。
  /// 模板取原岗位键（注入名与现状逐字节一致，如 `vteam-product`）；
  /// 自定义/克隆须由用户提供（service 层强制，DB 列保持可空以兼容存量行）。
  /// `Agent.role` 列已于 20260919000010 迁移 drop（agent-role-decommission todo 7）：
  /// 岗位标签改由 `AgentRole` / `TeamMember.roleId` 承载，能力由 `policyId` 承载。
  agentKey        String?  @unique @map("agent_key")
  // ⚠️ 出厂默认提示词为多段长文本（16 篇 §3~§7 四方向结构），MySQL 需 TEXT 承载
  prompt          String   @db.Text
  defaultModelId  String?  @map("default_model_id")
  // 首选 worker 软绑定（可空，null=自动调度；离线自动回退，Metis R1）
  workerId        String?  @map("worker_id")
  // @deprecated 2026-08-21 已下线：群聊 @Agent 自动回复“收到，正在处理…”机制已删除（模型不可用时无法区分）。
  // 列保留以兼容存量 DB，业务层已不再读写；下次重建库可删。
  ackMessage      String?  @map("ack_message")
  // 性格（vteam-team-collaboration tc-persona：PERSONA_LIBRARY 的 key，可空；
  // 存量 agent 不动，运行时由 buildSystemInstructions 拼接进系统提示，不改写 prompt）
  persona         String?
  policyId        String?  @map("policy_id")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  baseAgent         Agent?            @relation("AgentClone", fields: [baseAgentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clones            Agent[]           @relation("AgentClone")
  /// 以本 Agent 为默认 Agent 的角色（AgentRole.defaultAgentId，onDelete: SetNull）。
  defaultForRoles   AgentRole[]       @relation("AgentRoleDefaultAgent")
  creator           User              @relation("AgentCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skills            AgentSkill[]
  teamMembers       TeamMember[]
  sessions          Session[]
  channels          ChatChannel[]
  authoredArtifacts ArtifactVersion[] @relation("ArtifactAuthor")
  mainTasks         Task[]            @relation("TaskMainAgent")
  assignedIssues    Issue[]           @relation("IssueAssigneeAgent")
  createdIssues     Issue[]           @relation("IssueCreatorAgent")

  @@map("agents")
}

model ExecutionPolicy {
  id          String   @id
  name        String
  description String?  @db.Text
  type        String
  config      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("execution_policies")
}

model AgentSkill {
  id        String   @id
  agentId   String   @map("agent_id")
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([agentId, skillId], map: "uk_agent_skills_agent_skill")
  @@map("agent_skills")
}

// ==================================================================
// 技能工具域
// ==================================================================

model Skill {
  id          String   @id
  name        String   @unique
  // 技能描述可能超过 VARCHAR(191)，TEXT 承载（同类 description 长文本预防）
  description String?  @db.Text
  // SKILL.md 全文（T1 新增列：worker 注入需原文写出，DB 为唯一事实源）
  // F3-1：@db.Text 承载长文档（VARCHAR(191) 导致 >191 字符 SKILL.md 落库 500）
  // ⚠️ 不带 @default：MySQL TEXT 列禁止字面量默认值（P3018/1101），create 必传 content 无需 DB 默认
  content     String   @db.Text
  fileMeta    Json?    @map("file_meta")
  enabled     Boolean  @default(false)
  // 当前版本号（P3 skill 版本：每次 update/rollback 追加 SkillVersion 行后 +1，v1 由回填/create 落库）
  currentVersion Int      @default(1) @map("current_version")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agentSkills AgentSkill[]
  versions    SkillVersion[]

  @@map("skills")
}

// 技能版本历史（P3：append-only，update/rollback 追加新行从不改旧行；
// skill 删除级联清历史，versions 行 id `skv_` 前缀，onModuleInit 按前缀续号）
model SkillVersion {
  id        String   @id
  skillId   String   @map("skill_id")
  version   Int
  // 该版本的 SKILL.md 全文（回滚即取此列作为新版本内容）
  content   String   @db.Text
  fileMeta  Json?    @map("file_meta")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([skillId, version], map: "uk_skill_versions_skill_version")
  @@index([skillId], map: "idx_skill_versions_skill")
  @@map("skill_versions")
}

model Tool {
  id          String   @id
  name        String
  action      String   @unique
  source      String
  execution   String
  mcpServer   String?  @map("mcp_server")
  description String?  @db.Text
  schema      Json?
  initCommand Json?    @map("init_command")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("tools")
}

// ==================================================================
// 模型目录域（C1：models 目录 + worker 可用性映射；15 篇 §2.2 域前缀 md_）
// ==================================================================

model Model {
  id           String   @id
  providerID   String   @map("provider_id")
  modelID      String   @map("model_id")
  name         String
  capabilities Json?
  enabled      Boolean  @default(true)
  baseUrl      String?  @map("base_url") @db.Text
  providerType String   @default("cloud") @map("provider_type")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workerAvailabilities WorkerModelAvailability[]

  @@unique([providerID, modelID], map: "uk_models_provider_model")
  @@map("models")
}

model WorkerModelAvailability {
  workerId String @map("worker_id")
  modelId  String @map("model_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model  Model  @relation(fields: [modelId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([workerId, modelId])
  @@map("worker_model_availabilities")
}

// ==================================================================
// 模型凭据域（C4：provider token 加密存储；17 篇 §3.4 AES-256-GCM 基线）
// ==================================================================

model ModelCredential {
  id            String    @id
  // token 全局 provider 粒度（关键决策①）——凭据按 providerID 关联，不建 FK
  // （models.provider_id 非唯一，逻辑关联经 ModelsService 查询 provider 解析）
  providerID    String    @map("provider_id")
  // AES-256-GCM 加密后的 token 引用（明文零接触：不进日志/审计事件/响应）
  credentialRef String    @map("credential_ref") @db.Text
  // 脱敏标识（如 sk-****abc，fingerprint 不进日志/审计事件/响应）
  fingerprint   String
  // 软撤销（吊销 = 软删，保留审计轨迹；同 provider 重复 POST 覆盖更新时清除）
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([providerID], map: "uk_model_credentials_provider")
  @@map("model_credentials")
}

// ===== git 仓库凭证域（17 篇《仓库权限与凭证机制》§3.1/§3.2，B 方案落地）=====

model GitCredential {
  id            String    @id
  // 凭证名称（人类可识别，复用时区分，Q1 全局唯一）
  name          String    @unique
  // 认证方式：ssh_key | https_token
  authType      String    @map("auth_type")
  credentialRef String    @map("credential_ref") @db.Text
  fingerprint   String
  description   String?   @db.Text
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  revokedAt     DateTime? @map("revoked_at")

  @@map("git_credentials")
}

model GitRepo {
  id           String    @id
  repoUrl      String    @unique @map("repo_url")
  credentialId String    @map("credential_id")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  revokedAt    DateTime? @map("revoked_at")

  @@index([credentialId], map: "idx_git_repos_credential")
  @@map("git_repos")
}

model GitRepoGrant {
  id         String    @id
  // agentId 逻辑关联（不建 FK：agents 域主键，Agent 生命周期独立）
  // repoId 逻辑关联 GitRepo.id（不建 Prisma relation，Restrict 由服务层编排）
  agentId    String    @map("agent_id")
  repoId     String    @map("repo_id")
  permission String
  effect     String
  grantedBy  String    @map("granted_by")
  grantedAt  DateTime  @default(now()) @map("granted_at")
  revokedAt  DateTime? @map("revoked_at")

  @@unique([agentId, repoId], map: "uk_git_repo_grants_agent_repo")
  @@index([agentId], map: "idx_git_repo_grants_agent")
  @@index([repoId], map: "idx_git_repo_grants_repo")
  @@map("git_repo_grants")
}

// ==================================================================
// MCP 服务器域（11 篇 §5.1 / §5.8：mcp_servers 实体，T8a）
// ==================================================================

model McpServer {
  id        String   @id
  name      String   @unique
  type      String // local | remote（11 篇 §5.1 两型）
  command   Json? // local：{command[], cwd?, environment?, timeout?}
  url       String? // remote：合法 http(s) URL
  headers   Json? // remote：{header: value}
  oauth     Json? // remote：{clientId?, clientSecret?, scope?} 或 false（显式禁用）
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mcp_servers")
}

// ==================================================================
// Worker 域
// ==================================================================

model Worker {
  id              String    @id
  name            String?
  opencodeVersion String    @map("opencode_version")
  capabilities    Json
  load            Json?
  status          String    @default("offline")
  // worker 默认模型兜底（分派时 Agent 未配模型 → 用执行 worker 默认模型，C8）
  defaultModelId  String?   @map("default_model_id")
  tokenHash       String?   @map("token_hash")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  registeredAt    DateTime  @default(now()) @map("registered_at")

  sessions            Session[]
  taskGroupInstances  TaskGroupInstance[]
  modelAvailabilities WorkerModelAvailability[]

  @@index([status, lastHeartbeatAt], map: "idx_workers_status_heartbeat")
  @@map("workers")
}

model TaskGroupInstance {
  id           String    @id
  taskId       String?   @map("task_id")
  teamId       String?   @map("team_id")
  teamMemberId String?   @map("team_member_id")
  workerId     String    @map("worker_id")
  instanceId   String    @map("instance_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  removedAt    DateTime? @map("removed_at")

  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("task_group_instances")
}

// ==================================================================
// 实时事件域
// ==================================================================

model RealtimeEvent {
  id        String   @id
  type      String
  scopeType String   @map("scope_type")
  scopeId   String?  @map("scope_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([scopeType, scopeId, id], map: "idx_realtime_events_scope_id")
  @@map("realtime_events")
}

// ==================================================================
// 模型提问 / 工具权限确认域（worker 检测 serve pending → 落库 → 前端弹窗 → reply 收敛）
// ==================================================================

// ==================================================================
// 协作计划域（vteam-team-collaboration：pl_/pt_ 前缀主键；
// 双库兼容——不声明 Prisma enum，状态为 String 列 + 应用层常量）
// ==================================================================

// 任务执行计划（一任务一计划，taskId 唯一；status 字符串枚举：
// draft/reviewing/pending_final/approved/rejected/executing/completed，draft 为预留态）
// 2026-09-24 订正：上条"整体下线/保留空置"已过时——两表均为 live 表（2026-09-23 决策复活，
// 见 plan-steps.service.ts 头注释：opencode todos 会话级易失，plan_tasks 为 durable 跨会话存储）。
// plan_tasks 是唯一 choke 点，经 PlanStepsService 由 `vteam_todo` MCP 工具写入；
// opencode-todos 链已退役。两表勿 DROP。
model Plan {
  id                 String   @id // pl_ 前缀，服务层 IdGeneratorService 生成
  taskId             String   @unique @map("task_id") // 一任务一计划
  title              String
  summary            String?  @db.Text
  scopeIn            String?  @db.Text
  scopeOut           String?  @db.Text
  status             String // draft/reviewing/pending_final/approved/rejected/executing/completed
  createdBy          String   @map("created_by") // 主 Agent 实例 id
  reviewerInstanceId String?  @map("reviewer_instance_id") // 被指派评审者实例（null=用户评审/未指派)
  rejectCount        Int      @default(0) @map("reject_count")
  // todo2 plans 复活：用户确认审计（加法-only 可空列，todo11 确认门消费，命名锁定勿改）
  confirmedBy        String?  @map("confirmed_by")
  confirmedAt        DateTime? @map("confirmed_at")
  rejectReason       String?  @db.Text @map("reject_reason")
  // 定稿门审计（加法-only 可空列，finalize pending_final→approved 消费，命名锁定勿改）
  finalizedBy        String?  @map("finalized_by")
  finalizedAt        DateTime? @map("finalized_at")
  // 定稿冻结双锚（加法-only 可空列，plan-finalize-actions todo 2 finalize 消费，命名锁定勿改）
  frozenVersion      String?  @map("frozen_version")
  frozenHash         String?  @map("frozen_hash")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planTasks PlanTask[]

  @@map("plans")
}

// 计划子任务（pt_ 前缀；content 六要素 {what, mustNot, references, acceptance, qa, commit}，
// 允许字段缺省但 what 必填；assigneeInstanceId 指派实例，同角色多实例并行分发）
model PlanTask {
  id                 String   @id // pt_ 前缀，服务层 IdGeneratorService 生成
  planId             String   @map("plan_id")
  seq                Int
  title              String
  content            Json // 六要素 {what, mustNot, references, acceptance, qa, commit}
  assigneeInstanceId String?  @map("assignee_instance_id")
  status             String // pending/in_progress/done/blocked/skipped
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([planId, seq], map: "uk_plan_tasks_plan_seq")
  @@index([planId], map: "idx_plan_tasks_plan")
  @@map("plan_tasks")
}

// ==================================================================
// 记忆域（memory-management：me_ 前缀主键；task|team|global 字符串枚举，
// 双库兼容——不声明 Prisma enum；task 级冗余存 teamId 便于团队内检索）
// ==================================================================

model Memory {
  id               String    @id // me_ 前缀，服务层 IdGeneratorService 生成
  level            String // task|team|global（字符串枚举，双库兼容——不声明 Prisma enum）
  taskId           String?   @map("task_id")
  teamId           String?   @map("team_id") // team 级归属；task 级冗余存所属团队便于团队内检索
  content          String    @db.Text
  // 精确去重键（T4 记忆演进）：sha256(归一化 content)，save 前按 level+归属+hash 查命中
  // 即返 duplicate（check-then-insert 竞态接受，不建唯一键）；可空兼容存量行回填前。
  contentHash      String?   @map("content_hash")
  description      String?   @map("description") @db.VarChar(255) // 模型携带的30字摘要，用于索引/列表首屏，缺省回落 content.slice(0,120)
  tags             Json? // 标签数组
  createdBy        String    @map("created_by") // agent 实例 id 或 user id（兼容）
  sourceAgentId    String?   @map("source_agent_id")
  sourceInstanceId String?   @map("source_instance_id")
  sourceType       String?   @map("source_type") // agent|user|system
  sessionId        String?   @map("session_id")
  sessionTitle     String?   @map("session_title") @db.VarChar(512)
  channelId        String?   @map("channel_id")
  deletedAt        DateTime? @map("deleted_at") // 软删，对齐 ChatChannel:235
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([level], map: "idx_memories_level")
  @@index([taskId, createdAt], map: "idx_memories_task_time")
  @@index([teamId, createdAt], map: "idx_memories_team_time")
  @@index([contentHash], map: "idx_memories_content_hash")
  @@map("memories")
}

model AgentQuestion {
  id        String   @id
  // serve question/permission 请求 id（que_ / per_ 前缀，worker 检测上报的 requestId/permissionId）
  requestId String   @unique @map("request_id")
  // 平台 Session 主键（s_ 前缀，ingress resolvePlatformSessionId 归一后落库；reply 时反查 instanceRef 调 worker）
  sessionId String   @map("session_id")
  taskId    String   @map("task_id")
  agentId   String   @map("agent_id")
  // question | permission（worker 事件类型区分，两种确认共用一张表）
  kind      String
  // questions 数组（kind=question）或 {title, pattern, type}（kind=permission）
  content   Json
  // pending | resolved | rejected（resolved=已答复，rejected=用户拒绝）
  status    String   @default("pending")
  // 用户答复（kind=question: Array<Array<string>> label 数组；kind=permission: {response}）
  answers   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId, status], map: "idx_agent_questions_task_status")
  @@map("agent_questions")
}

// ==================================================================
// 消息渠道域（message-channels：mc_/md_ 前缀主键；inbound-only）
// 通知渠道域（notification-channels：nc_/nd_ 前缀主键；outbound-only）
// 任务绑定经关联表 TaskMessageChannel / TaskNotificationChannel
// ==================================================================

model MessageChannel {
  id         String   @id
  name       String   @db.VarChar(64)
  type       String   @db.VarChar(32)
  config     Json     @default("{}")
  secrets    Json     @default("{}")
  enabled    Boolean  @default(true)
  lastStatus String?  @map("last_status") @db.VarChar(16)
  lastError  String?  @map("last_error") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  deliveries MessageDelivery[]
  taskLinks  TaskMessageChannel[]
  teamLinks  TeamMessageChannel[]

  @@map("message_channels")
}

model MessageDelivery {
  id         String         @id
  channelId  String         @map("channel_id")
  channel    MessageChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalId String?        @map("external_id") @db.VarChar(128)
  direction  String         @default("inbound") @db.VarChar(8)
  status     String         @db.VarChar(16)
  kind       String?        @db.VarChar(32)
  error      String?        @db.VarChar(512)
  payload    Json?
  meta       Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@unique([channelId, externalId])
  @@index([channelId, createdAt])
  @@map("message_deliveries")
}

model NotificationChannel {
  id         String   @id
  name       String   @db.VarChar(64)
  type       String   @db.VarChar(32)
  config     Json     @default("{}")
  secrets    Json     @default("{}")
  enabled    Boolean  @default(true)
  lastStatus String?  @map("last_status") @db.VarChar(16)
  lastError  String?  @map("last_error") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]
  taskLinks  TaskNotificationChannel[]
  teamLinks  TeamNotificationChannel[]

  @@map("notification_channels")
}

model NotificationDelivery {
  id         String              @id
  channelId  String              @map("channel_id")
  channel    NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalId String?             @map("external_id") @db.VarChar(128)
  direction  String              @default("outbound") @db.VarChar(8)
  status     String              @db.VarChar(16)
  kind       String?             @db.VarChar(32)
  error      String?             @db.VarChar(512)
  payload    Json?
  meta       Json?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@unique([channelId, externalId])
  @@index([channelId, createdAt])
  @@map("notification_deliveries")
}

model TaskMessageChannel {
  taskId           String         @map("task_id")
  messageChannelId String         @map("message_channel_id")
  task             Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messageChannel   MessageChannel @relation(fields: [messageChannelId], references: [id], onDelete: Cascade)

  @@id([taskId, messageChannelId])
  @@unique([taskId, messageChannelId])
  @@index([taskId])
  @@map("task_message_channels")
}

model TaskNotificationChannel {
  taskId                String              @map("task_id")
  notificationChannelId String              @map("notification_channel_id")
  task                  Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  notificationChannel   NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)

  @@id([taskId, notificationChannelId])
  @@unique([taskId, notificationChannelId])
  @@index([taskId])
  @@map("task_notification_channels")
}

model TeamMessageChannel {
 teamId           String         @map("team_id")
 messageChannelId String         @map("message_channel_id")
 team             Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
 messageChannel   MessageChannel @relation(fields: [messageChannelId], references: [id], onDelete: Cascade)

 @@id([teamId, messageChannelId])
 @@unique([teamId, messageChannelId])
 @@index([teamId])
 @@map("team_message_channels")
}

model TeamNotificationChannel {
 teamId                String              @map("team_id")
 notificationChannelId String              @map("notification_channel_id")
 team                  Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
 notificationChannel   NotificationChannel @relation(fields: [notificationChannelId], references: [id], onDelete: Cascade)

 @@id([teamId, notificationChannelId])
 @@unique([teamId, notificationChannelId])
 @@index([teamId])
 @@map("team_notification_channels")
}
