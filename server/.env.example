# ============================================================
# server 环境变量模板（复制为 .env 后按环境填写）
# 生产/测试必须修改所有值，禁止使用示例值
# ============================================================

# ---- Prisma 数据源（MySQL，provider 见 prisma/schema.prisma 注释）----
# 本地开发：Docker 起 MySQL 后指向 localhost：
#   docker run -d --name aiagents-mysql -e MYSQL_ROOT_PASSWORD=root \
#     -e MYSQL_DATABASE=aiagents -p 3306:3306 mysql:8
DATABASE_URL="mysql://user:password@localhost:3306/aiagents"
# 生产示例（compose 内用服务名 db）：
# DATABASE_URL="mysql://aiagents:change-me@db:3306/aiagents"

# ---- JWT（08 篇 §7.6：access 短时效 + refresh 长时效）----
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- HTTP 服务 ----
PORT=3000

# ---- Worker 认证（worker 注册/事件上报 token，生产必改）----
WORKER_TOKEN="change-me-in-production"

# ---- Agent 工作目录（is_0000000010）----
# 每个 agent 实例独立持久化工作目录根（默认 /tmp/vteam-worker-tasks）。
# k8s/compose 生产建议挂持久卷到 /data/vteam-worker：创建任务时未指定 workDir 则默认
# 解析为 /data/vteam-worker/<sanitize(agent名称)>（同 agent 多实例追加 -<seq>），
# 容器重启后仅该目录及挂载卷内容保留。worker 侧执行端点会兜底 mkdir。
# WORK_DIR="/data/vteam-worker"

# ---- 模型凭据加密（C4，17 篇 §3.4：AES-256-GCM 主密钥，生产必改）----
# 32 字节密钥，支持 64 位 hex / base64 / 32 字节 utf8 三种编码。
# 生成方式（任选其一）：
#   openssl rand -hex 32          # 64 位 hex
#   openssl rand -base64 32       # base64
# 缺失时：生产环境启动抛错拒绝（绝不静默用弱 key）；开发/测试用显式标记的开发密钥（logger.warn）。
MODEL_CREDENTIAL_KEY="change-me-to-32-bytes-hex-key-00000000000000"

# ---- 文档站（is_0000000024 集成 prototype-viewer 文档渲染能力为任务产出物文档查看工具）----
# 镜像根目录（doc 产出物 → <docsRoot>/<taskId>/<slug>.md，派生视图，可全量重建）。
# v4 深度集成：无独立进程/无代理，仅需镜像根（数据端点直接读镜像）。
# 生产建议挂持久卷（如 /data/docs-root）；默认 server/docs-root。
# MD_DOCS_ROOT="/data/docs-root"
