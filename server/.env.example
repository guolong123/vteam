# ============================================================
# server 环境变量模板（复制为 .env 后按环境填写）
# 生产/测试必须修改所有值，禁止使用示例值
# ============================================================

# ---- Prisma 数据源（MySQL，provider 见 prisma/schema.prisma 注释）----
# 本地开发：Docker 起 MySQL 后指向 localhost：
#   docker run -d --name aiagents-mysql -e MYSQL_ROOT_PASSWORD=root \
#     -e MYSQL_DATABASE=aiagents -p 3306:3306 mysql:8
DATABASE_URL="mysql://user:password@localhost:3306/aiagents"
# 生产示例（compose 内用服务名 db）：
# DATABASE_URL="mysql://aiagents:change-me@db:3306/aiagents"

# ---- JWT（08 篇 §7.6：access 短时效 + refresh 长时效）----
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- HTTP 服务 ----
PORT=3000

# ---- Worker 认证（worker 注册/事件上报 token，生产必改）----
WORKER_TOKEN="change-me-in-production"
