  "evidence_C_resolution_chain_and_policy": {
    "chain": [
      "tools/call params.name (BARE) -> PlatformMcpController.toolsCall() resolves `this.tools.find(t => t.name === name)` (platform-mcp.controller.ts:172-212)",
      "args.selfInstanceId/teamId/taskId -> PlatformMcpService.resolveExecContext(ctx, args) (platform-mcp.service.ts:5881)",
      "  taskId path -> assertWorkerTask(ctx, taskId, selfInstanceId) (platform-mcp.service.ts:5807) -> ExecContext.callerId = session.teamMemberId ?? session.agentId",
      "  teamId path -> assertWorkerTeam(ctx, teamId, selfInstanceId) (platform-mcp.service.ts:5914) -> ExecContext.callerId = session.teamMemberId",
      "callerId (TeamMember.id, tmm_) -> TeamMember.agentId -> Agent.policyId / Agent.agentKey",
      "Agent.policyId/agentKey -> ExecutionPolicyService.resolveByAgent({policyId, agentKey}) (execution-policy.service.ts:663)",
      "  -> ResolvedExecutionPolicy.tools = guardForAgent(...) (execution-policy.service.ts:990)",
      "       = canonicalizeTools(config.tools) [DB row wins] ?? ROLE_BOUNDARIES[<bounded name>].toolAllows [constant fallback] (execution-policy.service.ts:337-346, 400-438)",
      "matrix key = `vteam_<action>` -> effect allow|ask|deny; value allow/ask => proceed, deny/absent => 403"
    ],
    "IMPORTANT_correction_to_the_brief": {
      "brief_said": "member -> TeamMember.roleId -> AgentRole -> the role's `tools` allowlist",
      "reality": "AgentRole carries NO capability fields (schema.prisma:124-151 doc-comment: '无任何能力字段：permission/tools/model/worker 属 ExecutionPolicy / Agent，不是角色属性'). The matrix is keyed off the AGENT (Agent.policyId / Agent.agentKey), NOT off TeamMember.roleId. TeamMember.roleId only supplies the prompt/label binding (rolePrompt / role name).",
      "consequence_for_todo_3": "Resolve via Agent.policyId (+ agentKey fallback), i.e. exactly what buildAgentPolicies() and the worker injection consume. Do not add a roleId-keyed lookup."
    },
    "unresolvable_identity_policy": {
      "rule": "FAIL-CLOSED: if the caller's role/tool matrix cannot be resolved to a definite allow/ask entry, refuse with 403 + a stable error code.",
      "per_case": {
        "no_x_worker_id_header": "already 403 MISSING_WORKER_ID today (assertWorkerTask:5816-5821) - keep, do not duplicate",
        "worker_not_bound_to_task_team": "already 403 FORBIDDEN today (assertWorkerTask:5840-5844, assertWorkerTeam:5935-5943) - keep",
        "selfInstanceId_missing_or_does_not_resolve_to_a_member": "403",
        "tool_name_not_in_the_role_matrix": "403 (not listed == deny; matches filterToolsMatrix/isToolAllowed semantics)",
        "resolveByAgent_returns_null": "403",
        "resolution_throws": "403 (log; never fall through to allow)"
      },
      "justification": "The worker-side guard passes through on unresolvable identity (worker/src/role-guard/policy.ts:109-121, comments '绝不 fail-closed'; same in session-policy-map.ts). That leniency is safe THERE because it hooks the engine's own tool pipeline and the guarded tools (edit/bash/task) are ALSO guarded by the engine's native permission config (layer 1), so pass-through leaves real confinement intact. The server-side check has NO such backstop: today the only thing stopping a developer from calling e.g. task_transition is the emitted `vteam_*: deny` permission entry, which todo 4 stops emitting and todo 5 stops feeding. Passing through on the server too would leave those tools unguarded after the worker layer is deleted - exactly the failure this plan exists to prevent.",
      "no_new_failure_mode_for_legitimate_callers": "Every in-band caller reaches a tool through a real session, so assertWorkerTask/assertWorkerTeam already resolve; all 7 live members carry a non-null role_id and template agents carry policy_id (verified in the live DB).",
      "in_repo_precedent_for_the_strict_posture": "assertWorkerTeam returns 403 when the worker<->team binding is absent; assertWorkerTask 403s on a missing session. The new check is additive on the same posture."
    },
