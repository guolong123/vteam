{
  "agents": [
    {
      "name": "vteam-plan",
      "description": "计划职责：只读分析并产出实施计划；不写文件、不执行变更。",
      "mode": "all",
      "permission": {
        "edit": {
          "*": "deny",
          "**.opencode/plans/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "allow",
        "task": "allow"
      }
    },
    {
      "name": "vteam-product",
      "description": "需求分析与原型设计：澄清并定义需求，产出需求文档与原型；不编写实现代码、不做技术方案、不替代测试判定。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/prototypes/**": "allow",
          "**tasks/*/docs/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    },
    {
      "name": "vteam-architect",
      "description": "技术方案与设计文档：基于需求产出架构/技术方案与设计文档，只读核对仓库；不编写实现代码。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/docs/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    },
    {
      "name": "vteam-developer",
      "description": "编码与实现说明：按需求/方案实现代码并给出实现说明与验证方式；不定义需求、不替代测试判定、不越权验收。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    },
    {
      "name": "vteam-tester",
      "description": "测试用例/计划/执行/报告：设计并执行测试、输出报告；不修改实现代码、不越权验收。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/tests/**": "allow",
          "**tasks/*/docs/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    },
    {
      "name": "vteam-project_manager",
      "description": "流程控制：负责进度跟踪、风险与阻塞协调；不拆解任务、不制定计划、不产出需求/方案/代码/用例、不越权验收。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "read": {
          "*": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    },
    {
      "name": "vteam-librarian",
      "description": "私域知识问答：只读检索已沉淀知识（记忆/文档库/文件/仓库）并作答，附出处与置信度；无出处即认不知；不写文件、不执行变更、不主动通知。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "read": {
          "*": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    }
  ],
