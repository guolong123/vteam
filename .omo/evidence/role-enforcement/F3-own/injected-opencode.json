{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vteam": {
      "type": "remote",
      "url": "http://server:3000/api/v1/platform-mcp",
      "headers": {
        "x-worker-id": "w_compose_worker",
        "x-worker-token": "compose-worker-token"
      },
      "enabled": true
    }
  },
  "agent": {
    "vteam-plan": {
      "description": "计划职责：只读分析并产出实施计划；不写文件、不执行变更。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "read": {
          "*": "allow"
        },
        "bash": "deny",
        "task": "deny",
        "vteam_chat_history": "deny",
        "vteam_group_post": "deny",
        "vteam_notify_agent": "deny",
        "vteam_submit_artifact": "deny",
        "vteam_issue_create": "deny",
        "vteam_issue_list": "deny",
        "vteam_issue_get": "deny",
        "vteam_issue_update": "deny",
        "vteam_issue_transition": "deny",
        "vteam_task_transition": "deny",
        "vteam_question_confirm": "deny",
        "vteam_memory_save": "deny",
        "vteam_memory_search": "deny",
        "vteam_team_add_member": "deny",
        "vteam_plan_mode": "deny",
        "vteam_channel_send": "deny",
        "vteam_wecom_reply": "deny"
      }
    },
    "vteam-product": {
      "description": "需求分析与原型设计：澄清并定义需求，产出需求文档与原型；不编写实现代码、不做技术方案、不替代测试判定。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/prototypes/**": "allow",
          "**tasks/*/docs/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "deny",
        "task": "deny",
        "vteam_task_transition": "deny",
        "vteam_question_confirm": "deny",
        "vteam_team_add_member": "deny",
        "vteam_plan_mode": "deny",
        "vteam_channel_send": "deny",
        "vteam_wecom_reply": "deny"
      }
    },
    "vteam-architect": {
      "description": "技术方案与设计文档：基于需求产出架构/技术方案与设计文档，只读核对仓库；不编写实现代码、不写仓库。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/docs/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "ask",
        "task": "deny",
        "vteam_issue_create": "deny",
        "vteam_issue_update": "deny",
        "vteam_issue_transition": "deny",
        "vteam_task_transition": "deny",
        "vteam_question_confirm": "deny",
        "vteam_team_add_member": "deny",
        "vteam_plan_mode": "deny",
        "vteam_channel_send": "deny",
        "vteam_wecom_reply": "deny"
      }
    },
    "vteam-developer": {
      "description": "编码与实现说明：按需求/方案实现代码并给出实现说明与验证方式；不定义需求、不替代测试判定、不越权验收。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "ask",
        "task": "deny",
        "vteam_doclib": "deny",
        "vteam_issue_create": "deny",
        "vteam_task_transition": "deny",
        "vteam_question_confirm": "deny",
        "vteam_team_add_member": "deny",
        "vteam_plan_mode": "deny",
        "vteam_channel_send": "deny",
        "vteam_wecom_reply": "deny"
      }
    },
    "vteam-tester": {
      "description": "测试用例/计划/执行/报告：设计并执行测试、输出报告；不修改实现代码、不越权验收。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "**tasks/*/tests/**": "allow",
          "**tasks/*/docs/**": "allow"
        },
        "read": {
          "*": "allow"
        },
        "bash": "ask",
        "task": "deny",
        "vteam_issue_update": "deny",
        "vteam_task_transition": "deny",
        "vteam_question_confirm": "deny",
        "vteam_team_add_member": "deny",
        "vteam_plan_mode": "deny",
        "vteam_channel_send": "deny",
        "vteam_wecom_reply": "deny"
      }
    },
    "vteam-project_manager": {
      "description": "流程控制：负责任务拆解编排、进度跟踪、风险与阻塞协调；不产出需求/方案/代码/用例、不越权验收。",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny"
        },
        "read": {
          "*": "allow"
        },
        "bash": "deny",
        "task": "deny",
        "vteam_chat_history": "deny",
        "vteam_submit_artifact": "deny",
        "vteam_task_transition": "deny",
        "vteam_question_confirm": "deny",
        "vteam_team_add_member": "deny",
        "vteam_plan_mode": "deny",
        "vteam_channel_send": "deny",
        "vteam_wecom_reply": "deny"
      }
    }
  },
  "plugin": [
    "./.opencode/plugin/vteam-role-guard.ts",
    "oh-my-openagent@latest"
  ]
}
